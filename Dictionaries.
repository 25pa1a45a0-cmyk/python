      "cell_type": "code",
      "source": [
        "#USER DEFINED KEYS VALUES TO GET DICTIONARY\n",
        "k=[i for i in input().split()]\n",
        "v=[(i) for i in input().split()]\n",
        "p={i:j for i,j in zip(k,v)}\n",
        "print(p)"
